service macvr-hal /vendor/bin/hw/macvr-hal
    class hal
    priority -8
    user system
    group system
    seclabel u:r:hal_graphics_composer_default:s0

# the emulator's adb runs over a qemu pipe, not USB: keep it up when Horizon turns USB debugging off
on property:sys.usb.config=none
    start adbd

# the display vsync node Meta's compositor reads (written by macvr-hal; see vsync.cpp)
on init
    mount tmpfs tmpfs /sys/class/drm mode=0755,uid=0,gid=1000
    symlink ../../devices/virtual/drm/ttm /sys/class/drm/ttm
    mkdir /sys/class/drm/sde-crtc-0 0755 system system
    write /sys/class/drm/sde-crtc-0/vsync_event "VSYNC=0"
    chown system system /sys/class/drm/sde-crtc-0/vsync_event
    chmod 0644 /sys/class/drm/sde-crtc-0/vsync_event

# first-time setup pairs the headset with a phone, which an emulator can't do: record it as done, as finishing it would
on property:sys.boot_completed=1
    exec - system system -- /system/bin/oculuspreferences --setc first_time_nux_complete true first_time_nux_pre_ota_complete true first_time_nux_guardian_setup_complete true
    exec - system system -- /system/bin/settings put global device_provisioned 1
    exec - system system -- /system/bin/settings put secure user_setup_complete 1

# Meta's telemetry daemon has nowhere to report to here and spins (over half a CPU), starving the compositor
on property:init.svc.telemetry=running
    stop telemetry
